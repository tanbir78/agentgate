"use client";

import { useCallback, useEffect, useState } from "react";
import {
  Activity,
  Bot,
  Wrench,
  ClipboardCheck,
  RefreshCw,
  AlertCircle,
  CheckCircle2,
  Clock3,
  ShieldCheck,
} from "lucide-react";
import { useAuth } from "@/components/auth/AuthProvider";

type PageResponse<T> = {
  content: T[];
  totalElements: number;
  totalPages: number;
  number: number;
  size: number;
};

type Agent = {
  id: string;
  name: string;
  active: boolean;
  clearance?: string;
};

type Tool = {
  id: string;
  name: string;
  active: boolean;
  riskLevel?: string;
};

type Approval = {
  id: string;
  agentId: string;
  toolId: string;
  status: string;
  requestedAt: string;
  expiresAt: string;
};

type DashboardData = {
  agents: PageResponse<Agent>;
  tools: PageResponse<Tool>;
  approvals: Approval[];
};

const cardClass =
  "rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5";

function StatCard({
  title,
  value,
  description,
  icon: Icon,
}: {
  title: string;
  value: number | string;
  description: string;
  icon: React.ElementType;
}) {
  return (
    <article className={cardClass}>
      <div className="flex items-center justify-between">
        <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--primary-soft)] text-[var(--primary)]">
          <Icon size={21} />
        </div>
        <span className="text-[10px] font-semibold text-[var(--success)]">
          DATABASE
        </span>
      </div>

      <p className="mt-5 text-xs font-medium text-[var(--muted)]">
        {title}
      </p>

      <h2 className="mt-1 text-3xl font-bold">
        {value}
      </h2>

      <p className="mt-2 text-[10px] text-[var(--muted)]">
        {description}
      </p>
    </article>
  );
}

async function readJson<T>(response: Response): Promise<T> {
  if (!response.ok) {
    const message = await response.text();
    throw new Error(
      `API request failed (${response.status}): ${message || response.statusText}`
    );
  }

  return response.json() as Promise<T>;
}

export default function DashboardOverview() {
  const { apiFetch } = useAuth();

  const [data, setData] = useState<DashboardData | null>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");

  const loadDashboard = useCallback(async (manual = false) => {
    if (manual) setRefreshing(true);
    else setLoading(true);

    setError("");

    try {
      const [agentResponse, toolResponse, approvalResponse] =
        await Promise.all([
          apiFetch("/api/v1/agents?page=0&size=1&sort=createdAt,desc"),
          apiFetch("/api/v1/tools?activeOnly=false&page=0&size=1&sort=createdAt,desc"),
          apiFetch("/api/v1/approvals?status=PENDING"),
        ]);

      const [agents, tools, approvals] = await Promise.all([
        readJson<PageResponse<Agent>>(agentResponse),
        readJson<PageResponse<Tool>>(toolResponse),
        readJson<Approval[]>(approvalResponse),
      ]);

      setData({ agents, tools, approvals });
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load dashboard data."
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, [apiFetch]);

  useEffect(() => {
    void loadDashboard();
  }, [loadDashboard]);

  const pendingCount = data?.approvals.length ?? 0;

  return (
    <div className="mx-auto max-w-[1500px] space-y-7">
      <section className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <div className="mb-2 flex items-center gap-2">
            <span className="h-1.5 w-1.5 rounded-full bg-[var(--primary)]" />
            <span className="text-[10px] font-bold uppercase tracking-[2px] text-[var(--primary)]">
              Security overview
            </span>
          </div>

          <h1 className="text-2xl font-bold tracking-tight sm:text-3xl">
            Dashboard Overview
          </h1>

          <p className="mt-2 text-sm text-[var(--muted)]">
            Live records retrieved from the AgentGate backend.
          </p>
        </div>

        <button
          onClick={() => void loadDashboard(true)}
          disabled={loading || refreshing}
          className="inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-xs font-semibold transition hover:bg-[var(--surface-hover)] disabled:opacity-50"
        >
          <RefreshCw
            size={15}
            className={refreshing ? "animate-spin" : ""}
          />
          Refresh data
        </button>
      </section>

      {error && (
        <div className="flex items-start gap-3 rounded-xl border border-[var(--danger)]/30 bg-[var(--danger)]/5 p-4">
          <AlertCircle size={18} className="mt-0.5 text-[var(--danger)]" />
          <div>
            <p className="text-sm font-semibold text-[var(--danger)]">
              Dashboard API error
            </p>
            <p className="mt-1 break-words text-xs text-[var(--muted)]">
              {error}
            </p>
            <button
              onClick={() => void loadDashboard(true)}
              className="mt-2 text-xs font-semibold text-[var(--primary)] hover:underline"
            >
              Try again
            </button>
          </div>
        </div>
      )}

      <section className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard
          title="Registered Agents"
          value={loading ? "—" : data?.agents.totalElements ?? 0}
          description="Total agents in database"
          icon={Bot}
        />

        <StatCard
          title="Registered Tools"
          value={loading ? "—" : data?.tools.totalElements ?? 0}
          description="Total registered tools"
          icon={Wrench}
        />

        <StatCard
          title="Pending Approvals"
          value={loading ? "—" : pendingCount}
          description="Awaiting approval decision"
          icon={ClipboardCheck}
        />

        <StatCard
          title="Active Policies"
          value="—"
          description="Policy list API not available yet"
          icon={ShieldCheck}
        />
      </section>

      <section className="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <div className={`${cardClass} xl:col-span-2`}>
          <div className="flex items-center gap-3">
            <Activity size={19} className="text-[var(--primary)]" />
            <div>
              <h2 className="text-sm font-semibold">
                Security Activity
              </h2>
              <p className="mt-1 text-xs text-[var(--muted)]">
                Audit event history
              </p>
            </div>
          </div>

          <div className="mt-6 rounded-xl border border-dashed border-[var(--border)] bg-[var(--background)] p-6">
            <p className="text-sm font-semibold">
              Audit API not available
            </p>
            <p className="mt-2 text-xs leading-6 text-[var(--muted)]">
              Audit events are persisted by the backend, but there is no
              read endpoint yet. The chart will appear after the audit
              listing API is implemented.
            </p>
          </div>
        </div>

        <div className={cardClass}>
          <div className="flex items-center gap-3">
            <CheckCircle2 size={19} className="text-[var(--primary)]" />
            <div>
              <h2 className="text-sm font-semibold">
                Backend Integration
              </h2>
              <p className="mt-1 text-xs text-[var(--muted)]">
                API connection status
              </p>
            </div>
          </div>

          <div className="mt-6 space-y-4">
            {[
              {
                name: "Agents API",
                ok: Boolean(data),
              },
              {
                name: "Tools API",
                ok: Boolean(data),
              },
              {
                name: "Approvals API",
                ok: Boolean(data),
              },
              {
                name: "Policies API",
                ok: false,
              },
              {
                name: "Audit read API",
                ok: false,
              },
            ].map((item) => (
              <div
                key={item.name}
                className="flex items-center justify-between gap-3"
              >
                <span className="text-xs font-medium">{item.name}</span>
                <span
                  className={`rounded-lg px-2.5 py-1 text-[10px] font-bold ${
                    item.ok
                      ? "bg-[var(--primary-soft)] text-[var(--success)]"
                      : "bg-[var(--warning)]/10 text-[var(--warning)]"
                  }`}
                >
                  {item.ok ? "CONNECTED" : "NOT AVAILABLE"}
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section className={cardClass}>
        <div className="flex items-center gap-3">
          <Clock3 size={19} className="text-[var(--primary)]" />
          <div>
            <h2 className="text-sm font-semibold">
              Pending Approval Requests
            </h2>
            <p className="mt-1 text-xs text-[var(--muted)]">
              Actual pending records from the approvals endpoint
            </p>
          </div>
        </div>

        {loading ? (
          <p className="mt-6 text-xs text-[var(--muted)]">
            Loading approval records...
          </p>
        ) : !data?.approvals.length ? (
          <div className="mt-6 rounded-xl border border-dashed border-[var(--border)] p-6 text-center">
            <CheckCircle2
              size={24}
              className="mx-auto text-[var(--success)]"
            />
            <p className="mt-2 text-sm font-semibold">
              No pending approvals
            </p>
            <p className="mt-1 text-xs text-[var(--muted)]">
              The backend returned an empty pending approval list.
            </p>
          </div>
        ) : (
          <div className="mt-5 space-y-3">
            {data.approvals.slice(0, 8).map((approval) => (
              <div
                key={approval.id}
                className="flex flex-col gap-2 rounded-xl border border-[var(--border)] bg-[var(--background)] p-4 sm:flex-row sm:items-center sm:justify-between"
              >
                <div className="min-w-0">
                  <p className="truncate text-xs font-semibold">
                    Approval {approval.id}
                  </p>
                  <p className="mt-1 text-[10px] text-[var(--muted)]">
                    Agent: {approval.agentId}
                  </p>
                </div>

                <div className="flex items-center gap-2">
                  <span className="rounded-lg bg-[var(--warning)]/10 px-2.5 py-1 text-[10px] font-bold text-[var(--warning)]">
                    {approval.status}
                  </span>
                  <span className="text-[10px] text-[var(--muted)]">
                    {new Date(approval.requestedAt).toLocaleString()}
                  </span>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <p className="text-center text-[10px] text-[var(--muted)]">
        Dashboard values are loaded from backend API responses. Unavailable
        metrics are intentionally not fabricated.
      </p>
    </div>
  );
}