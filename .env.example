# Generate independent random secrets; never use these example values in production.
DB_PASSWORD=replace-with-a-strong-database-password
AUDIT_CHECKPOINT_SECRET=replace-with-at-least-32-random-characters
# Generate a persistent RSA key pair once and store base64-encoded PEM DER values here:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Linux: base64 -w0 jwt-private.pem ; base64 -w0 jwt-public.pem
JWT_PRIVATE_KEY_BASE64=replace-with-base64-encoded-private-pem
JWT_PUBLIC_KEY_BASE64=replace-with-base64-encoded-public-pem
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DELEGATION_SIGNING_SECRET=replace-with-a-separate-32-character-delegation-secret
AGENTGATE_ISSUER=http://localhost:8080
